# NGM log indexer: tails NGM log files into a rebuildable search index
# (unprivileged; reads /var/log/ngm, writes only /var/lib/ngm).
[Unit]
Description=NGM log indexer
After=network-online.target

[Service]
Type=simple
ExecStart=/opt/ngm/current/ngm --config /etc/ngm/ngm.json log-indexer
User=ngm-logs
Group=ngm
UMask=0007
Restart=on-failure
RestartSec=3
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ngm
ReadOnlyPaths=/var/log/ngm
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=50%
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
