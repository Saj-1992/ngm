# NGM monitor: active backend health checks (unprivileged; no vault access).
[Unit]
Description=NGM monitor
After=network-online.target

[Service]
Type=simple
ExecStart=/opt/ngm/current/ngm --config /etc/ngm/ngm.json monitor
User=ngm-monitor
Group=ngm
UMask=0007
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ngm /var/log/ngm
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=192M
OOMScoreAdjust=400

[Install]
WantedBy=multi-user.target
